# FastAPI sunucusunun adresi. Boş bırakılırsa istekler aynı origin'e (/api) gider ve
# geliştirmede Vite proxy'si üzerinden VITE_PROXY_TARGET'a yönlendirilir.
VITE_API_BASE_URL=
# Geliştirmede proxy hedefi (docker compose'daki backend servisi)
VITE_PROXY_TARGET=http://localhost:8000
# true: sahte veri servisi (MSW) ile çalışır, backend gerekmez
VITE_USE_MOCKS=true
